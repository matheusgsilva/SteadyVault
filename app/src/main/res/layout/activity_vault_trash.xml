<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/trashRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="22sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:includeFontPadding="false" android:lineSpacingExtra="0dp" android:maxLines="2" android:singleLine="false" android:text="Lixeira dos cofres" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/trashSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:text="Itens excluídos permanecem privados" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/trashBackButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_arrow_back" android:tint="@color/accent" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Cofre" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/trashSelectAllButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_select_all" android:tint="@color/accent" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/trashSelectAllLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Selecionar" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/trashDeleteSelectedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_danger" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:visibility="gone" android:paddingTop="0dp" android:paddingBottom="0dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_trash" android:tint="@color/accent" android:layout_marginEnd="4dp"/>
                <TextView android:id="@+id/trashDeleteSelectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Excluir sel." android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/trashEmptyButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_danger" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_trash" android:tint="@color/accent" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Esvaziar" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="16dp">
        <GridView android:id="@+id/trashGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:horizontalSpacing="5dp" android:numColumns="3" android:overScrollMode="never" android:scrollbars="none" android:stretchMode="columnWidth" android:verticalSpacing="5dp"/>
        <TextView android:id="@+id/trashEmptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="40dp" android:text="A lixeira está vazia" android:textColor="@color/text_secondary" android:textSize="15sp"/>
        <LinearLayout android:id="@+id/trashBusyOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#CC05070B" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <ProgressBar android:layout_width="44dp" android:layout_height="44dp" android:indeterminate="true"/>
            <TextView android:id="@+id/trashBusyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Processando…" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
