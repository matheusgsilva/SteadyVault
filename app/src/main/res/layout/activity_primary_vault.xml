<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/libraryRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:gravity="center_vertical" android:baselineAligned="false" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="22sp" android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:includeFontPadding="false" android:lineSpacingExtra="0dp" android:maxLines="2" android:singleLine="false" android:text="Cofre principal" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:id="@+id/importMediaButton" android:layout_width="52dp" android:layout_height="44dp" android:background="@drawable/bg_oneui_button_secondary" android:contentDescription="Importar mídia" android:gravity="center" android:includeFontPadding="false" android:text="+" android:textColor="@color/accent" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:id="@+id/lockVaultButton" android:layout_width="104dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:background="@drawable/bg_oneui_button_secondary" android:drawableStart="@drawable/ic_lock" android:drawablePadding="4dp" android:drawableTint="@color/accent" android:gravity="center" android:maxLines="2" android:paddingHorizontal="9dp" android:text="Criar PIN" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:includeFontPadding="false" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:paddingStart="6dp" android:paddingEnd="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/storageSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:text="Fotos e vídeos privados no aparelho" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp">
            <LinearLayout android:id="@+id/gridControls" android:layout_width="match_parent" android:layout_height="94dp" android:orientation="vertical">
                <TextView android:id="@+id/galleryViewSummary" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:maxLines="2" android:text="Todas as mídias • mais recentes" android:textColor="@color/text_secondary" android:textSize="11.5sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/albumFilterButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_album" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/albumFilterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Álbum" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/filterSortButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_sort" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/filterSortLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Recentes" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/gridSizeButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_grid" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/gridSizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Grade 3" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/trashButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_trash" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/trashLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Lixeira" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/selectionBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="5dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/selectionCount" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="5dp" android:text="1 selecionado" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/cancelSelectionButton" android:layout_width="36dp" android:layout_height="32dp" android:background="@drawable/bg_oneui_button_secondary" android:gravity="center" android:includeFontPadding="false" android:text="×" android:textColor="@color/text_secondary" android:textSize="22sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="2dp" android:orientation="horizontal">
                    <LinearLayout android:id="@+id/selectAllButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_select_all" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/selectAllLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Tudo" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/albumSelectedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_album" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/albumSelectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Álbum" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/exportSelectedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_export" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/exportSelectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Exportar" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/deleteSelectedButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp" android:layout_marginStart="5dp" android:paddingTop="0dp" android:paddingBottom="0dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_trash" android:tint="@color/accent" android:layout_marginEnd="@dimen/action_icon_text_spacing"/>
                        <TextView android:id="@+id/deleteSelectedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="2" android:text="Excluir" android:textColor="@color/text_primary" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <GridView android:id="@+id/mediaGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:gravity="center" android:horizontalSpacing="2dp" android:numColumns="3" android:overScrollMode="never" android:paddingStart="2dp" android:paddingTop="2dp" android:paddingEnd="2dp" android:paddingBottom="10dp" android:scrollbars="none" android:stretchMode="columnWidth" android:verticalSpacing="2dp"/>
        <TextView android:id="@+id/emptyLibraryText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="40dp" android:text="Nenhuma mídia no cofre" android:textAlignment="center" android:textColor="@color/text_secondary" android:textSize="15sp"/>
        <LinearLayout android:id="@+id/lockedVaultPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Cofre bloqueado" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Use sua biometria ou PIN para continuar." android:textColor="@color/text_secondary" android:textSize="13sp"/>
            <LinearLayout android:id="@+id/biometricUnlockButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:background="@drawable/bg_oneui_button_primary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_fingerprint" android:tint="@color/background"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Usar biometria" android:textColor="@color/background" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/pinUnlockButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_pin" android:tint="@color/accent"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Usar PIN" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textAlignment="center" android:maxLines="2" android:singleLine="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:breakStrategy="balanced" android:hyphenationFrequency="none"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/vaultImportPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_oneui_dialog" android:elevation="12dp" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ProgressBar android:layout_width="30dp" android:layout_height="30dp" android:indeterminate="true"/>
                <TextView android:id="@+id/vaultImportProgressText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Importando…" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/vaultImportCancelButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Cancelar importação" android:textColor="@color/record_red" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/vaultBusyOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#CC05070B" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <ProgressBar android:layout_width="44dp" android:layout_height="44dp" android:indeterminate="true"/>
            <TextView android:id="@+id/vaultBusyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Processando…" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="A importação continua protegida; ao desbloquear você vê o resultado." android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/view_bottom_navigation"/>
</LinearLayout>
