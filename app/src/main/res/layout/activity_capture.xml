            <TextView android:id="@+id/previewSettingsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:background="@drawable/bg_profile_action" android:ellipsize="end" android:gravity="center" android:maxLines="2" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="Carregando configurações aplicadas…" android:textColor="@android:color/white" android:textSize="9.7sp" android:textStyle="bold"/>

