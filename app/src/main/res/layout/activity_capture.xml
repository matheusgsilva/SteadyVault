                        <ImageView android:id="@+id/previewLastMediaThumbnail" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Abrir cofre protegido" android:scaleType="centerCrop" android:src="@drawable/ic_nav_vault"/>
                        <ImageView android:id="@+id/previewLastMediaPlay" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_status_card" android:contentDescription="Vídeo" android:padding="5dp" android:src="@drawable/ic_play" android:visibility="gone"/>
                    </FrameLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="86dp" android:layout_height="match_parent" android:gravity="center">
                    <FrameLayout android:id="@+id/previewRecordButton" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:background="@drawable/bg_camera_shutter_outer" android:clickable="true" android:focusable="true" android:padding="11dp">
                        <View android:id="@+id/previewRecordFill" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_shutter_yellow_fill"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/previewPhotoButton" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:background="@drawable/bg_camera_shutter_outer" android:clickable="true" android:contentDescription="Tirar foto" android:focusable="true" android:padding="11dp" android:visibility="gone">
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_camera_shutter_photo"/>
                    </FrameLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <ImageView android:id="@+id/previewCameraSwitchButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="@drawable/bg_status_card" android:clickable="true" android:contentDescription="Alternar câmera" android:focusable="true" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_camera_switch_refined"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <View android:id="@+id/previewSettingsScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#73000000" android:clickable="true" android:focusable="true" android:visibility="gone"/>
        <LinearLayout android:id="@+id/previewSettingsSheet" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_preview_settings_sheet" android:elevation="40dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="4dp" android:visibility="gone">
            <View android:layout_width="46dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="#77FFFFFF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/bg_profile_action" android:gravity="center" android:orientation="horizontal" android:padding="2dp">
                <LinearLayout android:id="@+id/previewSettingsGeneralTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_preview_settings_tab_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/previewSettingsGeneralTabIcon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_tab_general" android:tint="#EFFFFFFF"/>
                    <TextView android:id="@+id/previewSettingsGeneralTabText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:includeFontPadding="false" android:text="Geral" android:textColor="#BFFFFFFF" android:textSize="9.5sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/previewSettingsCamerasTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_preview_settings_tab_selected" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/previewSettingsCamerasTabIcon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_tab_cameras" android:tint="@android:color/white"/>
                    <TextView android:id="@+id/previewSettingsCamerasTabText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:includeFontPadding="false" android:text="Câmeras" android:textColor="@android:color/white" android:textSize="9.5sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/previewSettingsPhotoTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_preview_settings_tab_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/previewSettingsPhotoTabIcon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_tab_photo" android:tint="#EFFFFFFF"/>
                    <TextView android:id="@+id/previewSettingsPhotoTabText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:includeFontPadding="false" android:text="Foto" android:textColor="#BFFFFFFF" android:textSize="9.5sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/previewSettingsVideoTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_preview_settings_tab_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/previewSettingsVideoTabIcon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_tab_video" android:tint="#EFFFFFFF"/>
                    <TextView android:id="@+id/previewSettingsVideoTabText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:includeFontPadding="false" android:text="Vídeo" android:textColor="#BFFFFFFF" android:textSize="9.5sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/previewSettingsProTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_preview_settings_tab_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:id="@+id/previewSettingsProTabIcon" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" android:src="@drawable/ic_tab_pro" android:tint="#EFFFFFFF"/>
                    <TextView android:id="@+id/previewSettingsProTabText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:includeFontPadding="false" android:text="Pro" android:textColor="#BFFFFFFF" android:textSize="9.5sp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/previewSettingsContentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Perfis por câmera" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/previewSettingsContentSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Cada câmera mantém configurações próprias para foto e vídeo." android:textColor="#B8FFFFFF" android:textSize="9.5sp"/>
            <ScrollView android:id="@+id/previewCameraProfilesScroll" android:layout_width="match_parent" android:layout_height="132dp" android:layout_marginTop="5dp" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
                <LinearLayout android:id="@+id/previewCameraProfilesRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical"/>
            </ScrollView>
            <ScrollView android:id="@+id/previewSettingsActionsScroll" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="6dp" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
                <LinearLayout android:id="@+id/previewSettingsActionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </ScrollView>
            <TextView android:id="@+id/previewManageProfilesButton" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:background="@drawable/bg_profile_action" android:clickable="true" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="8dp" android:focusable="true" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="12dp" android:text="Gerenciar ajustes avançados" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
