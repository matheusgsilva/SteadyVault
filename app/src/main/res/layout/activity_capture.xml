                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="ACESSO RÁPIDO" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:id="@+id/previewModeButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_capture_utility" android:clickable="true" android:contentDescription="Abrir câmera e ajustar" android:drawableStart="@drawable/ic_visibility" android:drawablePadding="@dimen/action_icon_text_spacing" android:drawableTint="@color/accent" android:focusable="true" android:gravity="center" android:maxLines="2" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Abrir câmera" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/backgroundRecordingZoomButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_capture_utility" android:clickable="true" android:contentDescription="Alterar zoom da captura rápida" android:drawableStart="@drawable/ic_zoom" android:drawablePadding="@dimen/action_icon_text_spacing" android:drawableTint="@color/accent" android:focusable="true" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="1x" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="MODO DE VÍDEO" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:id="@+id/fps30Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_mode_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Analisando\n30 FPS" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/fps60Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_mode_selected" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Analisando\n60 FPS" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/fps120Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:visibility="gone" android:layout_weight="1" android:background="@drawable/bg_mode_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Analisando\n120 FPS" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/fps240Button" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:visibility="gone" android:layout_weight="1" android:background="@drawable/bg_mode_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Analisando\n240 FPS" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/modeInfoText" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/captureActionGroups" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
                    <TextView android:id="@+id/videoActionsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="VÍDEO" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/videoActionsGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:id="@+id/startButton" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="1.45" android:background="@drawable/bg_capture_action_teal" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_record" android:tint="@android:color/white"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Gravar vídeo" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="66dp" android:layout_marginStart="8dp" android:layout_weight="0.75" android:background="@drawable/bg_capture_action_disabled" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_stop" android:tint="@android:color/white"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Parar" android:textColor="@android:color/white" android:textSize="12.5sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/photoActionsTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:includeFontPadding="false" android:text="FOTO" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/photoActionsGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <LinearLayout android:id="@+id/burstButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:background="@drawable/bg_capture_action_cyan" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_burst" android:tint="@android:color/white"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Sequência" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/photoButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_capture_action_green" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_camera" android:tint="@android:color/white"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="Tirar foto" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:text="SISTEMA" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/batteryStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Verificando bateria…" android:textColor="@color/text_secondary" android:textSize="10.5sp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <LinearLayout android:id="@+id/batteryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_capture_utility" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_battery"/>
                            <TextView android:id="@+id/batteryButtonText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Bateria" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/widgetButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_capture_utility" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:layout_marginEnd="@dimen/action_icon_text_spacing" android:contentDescription="@null" android:src="@drawable/ic_widget"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:text="Adicionar widget" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_bottom_navigation"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/cameraPreviewContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" android:clickable="true" android:focusable="true" android:visibility="gone" android:elevation="24dp">
        <SurfaceView android:id="@+id/cameraPreviewTexture" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true"/>
        <com.steadyvault.camera.ui.capture.PreviewGridOverlayView android:id="@+id/previewGridOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:visibility="gone"/>
        <View android:id="@+id/previewPausedScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#A6000000" android:visibility="gone"/>
        <TextView android:id="@+id/previewPausedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:paddingStart="32dp" android:paddingEnd="32dp" android:text="Preview pausado para preservar o desempenho" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold" android:visibility="gone"/>

        <LinearLayout android:id="@+id/previewTopPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:background="#12000000" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="SteadyVault" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold"/>
                <TextView android:id="@+id/previewModeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_preview_mode_badge" android:gravity="center" android:includeFontPadding="false" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="FOTO" android:textAllCaps="true" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
                <TextView android:id="@+id/previewPerformanceText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="#66000000" android:clickable="true" android:focusable="true" android:fontFamily="monospace" android:includeFontPadding="false" android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="8dp" android:paddingBottom="4dp" android:text="FPS real -- / --" android:textColor="@android:color/white" android:textSize="11sp" android:contentDescription="Mostrador de fps e exposição. Toque para alternar detalhes"/>
            </LinearLayout>
            <ImageView android:id="@+id/previewHideTopButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_preview_top_action" android:clickable="true" android:contentDescription="Ocultar informações superiores" android:focusable="true" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_visibility_off"/>
            <ImageView android:id="@+id/previewSettingsButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_preview_top_action" android:clickable="true" android:contentDescription="Abrir configurações da câmera" android:focusable="true" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_preview_settings"/>
            <ImageView android:id="@+id/previewOverlayButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_preview_top_action" android:clickable="true" android:contentDescription="Fechar preview" android:focusable="true" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_close"/>
        </LinearLayout>

        <ImageView android:id="@+id/previewShowTopButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|start" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:background="@drawable/bg_preview_top_action" android:clickable="true" android:contentDescription="Mostrar informações superiores" android:elevation="12dp" android:focusable="true" android:padding="11dp" android:scaleType="centerInside" android:src="@drawable/ic_visibility" android:visibility="gone"/>
        <ImageView android:id="@+id/previewQuickCloseButton" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_preview_top_action" android:clickable="true" android:contentDescription="Fechar preview" android:elevation="14dp" android:focusable="true" android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/ic_close"/>

        <LinearLayout android:id="@+id/previewBottomPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@drawable/bg_capture_preview_bottom_overlay" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="8dp">
            <LinearLayout android:id="@+id/previewZoomRow" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/previewZoom06Button" android:layout_width="42dp" android:layout_height="38dp" android:background="@drawable/bg_camera_chip_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="0,6x" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/previewZoom1Button" android:layout_width="42dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_camera_chip_selected_yellow" android:clickable="true" android:focusable="true" android:gravity="center" android:text="1x" android:textColor="@android:color/black" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/previewZoom3Button" android:layout_width="42dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_camera_chip_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="3x" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold"/>
                <TextView android:id="@+id/previewZoom5Button" android:layout_width="42dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_camera_chip_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="5x" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/previewCaptureModeRow" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/previewPhotoModeButton" android:layout_width="104dp" android:layout_height="match_parent" android:background="@drawable/bg_camera_chip_unselected" android:clickable="true" android:focusable="true" android:gravity="center" android:text="FOTO" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/previewVideoModeButton" android:layout_width="104dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/bg_camera_chip_selected_yellow" android:clickable="true" android:focusable="true" android:gravity="center" android:text="VÍDEO" android:textColor="@android:color/black" android:textSize="12sp" android:textStyle="bold"/>
