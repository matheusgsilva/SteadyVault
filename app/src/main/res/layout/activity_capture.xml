                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:text="CAPTURA PRIVADA" android:textColor="@color/accent" android:textSize="9sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/modeSummaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:gravity="end" android:includeFontPadding="false" android:maxLines="2" android:maxWidth="168dp" android:minWidth="108dp" android:text="Analisando modos…\nCâmera + encoder" android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/captureStatusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_status_card" android:gravity="center" android:minHeight="82dp" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
                    <View android:id="@+id/statusDot" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_ready_dot"/>
