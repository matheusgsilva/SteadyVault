<?xml version='1.0' encoding='UTF-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/captureScreenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:id="@+id/captureContentRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <ScrollView android:id="@+id/captureScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
            <LinearLayout android:id="@+id/mainRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/background" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
                <LinearLayout android:id="@+id/captureHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
