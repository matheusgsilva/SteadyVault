<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_expanded_oneui"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="2dp"
    android:paddingEnd="8dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/widgetLogoArea"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_widget_expanded_logo"
        android:clickable="true"
        android:contentDescription="@string/app_name"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="0dp">

        <ImageView
            android:id="@+id/widgetAppLogo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/widget_logo" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widgetDivider"
        android:layout_width="1dp"
        android:layout_height="52dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/bg_widget_expanded_divider"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_weight="1"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetZoom"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="1"
            android:background="@drawable/bg_widget_expanded_button_teal"
            android:contentDescription="@string/zoom_content_description"
            android:drawablePadding="0dp"
            android:drawableTop="@drawable/ic_zoom"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="3dp"
            android:paddingTop="6dp"
            android:paddingEnd="3dp"
            android:paddingBottom="5dp"
            android:text="@string/widget_zoom_preview"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widgetSequence"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/bg_widget_expanded_button_cyan"
            android:contentDescription="@string/sequence_content_description"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_burst" />

        <ImageView
            android:id="@+id/widgetPhoto"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/bg_widget_expanded_button_green"
            android:contentDescription="@string/photo_content_description"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_camera" />

        <ImageView
            android:id="@+id/widgetStart"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/bg_widget_expanded_button_teal"
            android:contentDescription="@string/record_content_description"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_record" />

        <ImageView
            android:id="@+id/widgetStop"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:alpha="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/bg_widget_expanded_button_disabled"
            android:contentDescription="@string/stop_content_description"
            android:enabled="false"
            android:padding="18dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_stop_off" />
    </LinearLayout>
</LinearLayout>
