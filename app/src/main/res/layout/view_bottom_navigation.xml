<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav_glass"
    android:elevation="20dp"
    android:gravity="center"
    android:minHeight="88dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/navRecord"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_record"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:text="Gravar"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navLibrary"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_vault"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:text="Cofre"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navSettings"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_settings"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:text="Ajustes"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
