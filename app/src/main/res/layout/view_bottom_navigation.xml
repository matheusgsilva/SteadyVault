<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_elevated"
    android:elevation="16dp"
    android:gravity="center"
    android:minHeight="82dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/navRecord"
        android:layout_width="64dp"
        android:layout_height="58dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_record"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="Gravar"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navLibrary"
        android:layout_width="64dp"
        android:layout_height="58dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_vault"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="Cofre"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />



    <TextView
        android:id="@+id/navSettings"
        android:layout_width="64dp"
        android:layout_height="58dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/bg_nav_unselected"
        android:drawableTop="@drawable/ic_nav_settings"
        android:drawableTint="@color/text_secondary"
        android:drawablePadding="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="Ajustes"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
