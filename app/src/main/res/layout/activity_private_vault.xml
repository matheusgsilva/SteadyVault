<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/privateGalleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/privateGalleryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeMinTextSize="22sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="balanced"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="2"
                android:singleLine="false"
                android:text="Cofre privado"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/privateGalleryAdd"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_oneui_button_secondary"
                android:clickable="true"
                android:contentDescription="Adicionar mídia"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="0dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    android:tint="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privateGalleryClose"
                android:layout_width="104dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_oneui_button_secondary"
                android:clickable="true"
                android:contentDescription="Fechar cofre"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/privateGalleryCloseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:breakStrategy="balanced"
                    android:gravity="center"
                    android:hyphenationFrequency="none"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:singleLine="false"
                    android:text="Bloquear"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/privateGallerySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="Fotos e vídeos privados no aparelho"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <LinearLayout
                android:id="@+id/privateGridControls"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/privateGalleryViewSummary"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:maxLines="2"
                    android:text="Todas as mídias • mais recentes"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/privateGalleryType"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_album"
                            android:tint="@color/accent" />

                        <TextView
                            android:id="@+id/privateGalleryTypeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Mídia"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/privateGalleryFilter"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sort"
                            android:tint="@color/accent" />

                        <TextView
                            android:id="@+id/privateGalleryFilterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Recentes"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/privateGalleryGridSize"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_grid"
                            android:tint="@color/accent" />

                        <TextView
                            android:id="@+id/privateGalleryGridSizeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Grade 3"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/privateGalleryTrash"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trash"
                            android:tint="@color/accent" />

                        <TextView
                            android:id="@+id/privateGalleryTrashLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Lixeira"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privateSelectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/privateSelectionCount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:paddingStart="5dp"
                        android:text="1 selecionada"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/privateGalleryClearSelection"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="×"
                        android:textColor="@color/text_secondary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/privateGallerySelectAll"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_select_all"
                            android:tint="@color/accent" />

                        <TextView
                            android:id="@+id/privateGallerySelectAllLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Tudo"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/privateGalleryDeleteSelected"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_oneui_button_danger"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_trash"
                            android:tint="@color/accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="10sp"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="balanced"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:singleLine="false"
                            android:text="Excluir"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="16dp">

        <GridView
            android:id="@+id/privateGalleryGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:gravity="center"
            android:horizontalSpacing="2dp"
            android:numColumns="3"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="2dp" />

        <TextView
            android:id="@+id/privateGalleryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="40dp"
            android:text="Nenhuma mídia neste cofre"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/privateImportPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_oneui_dialog"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ProgressBar android:layout_width="30dp" android:layout_height="30dp" android:indeterminate="true" />
                <TextView android:id="@+id/privateImportProgressText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Importando…" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/privateImportCancelButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_oneui_button_secondary" android:clickable="true" android:focusable="true" android:gravity="center" android:text="Cancelar importação" android:textColor="@color/record_red" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privateBusyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC05070B"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/privateBusyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Processando…"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
