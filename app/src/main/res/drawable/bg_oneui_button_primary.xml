<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape><solid android:color="#3D314A52"/><stroke android:width="1dp" android:color="#345D7880"/><corners android:radius="27dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#20FFFFFF" android:endColor="#1025363C"/><corners android:radius="26dp"/></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#D354C0D0"/><stroke android:width="1dp" android:color="#E9E6FDFF"/><corners android:radius="27dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#B8FFFFFF" android:centerColor="#C261CFDC" android:endColor="#A33BA0B0"/><corners android:radius="26dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#C34BC1D2"/><stroke android:width="1dp" android:color="#DBD8FAFF"/><corners android:radius="27dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#A8FFFFFF" android:centerColor="#B96FD9E6" android:endColor="#9B3AA1B1"/><stroke android:width="1dp" android:color="#36FFFFFF"/><corners android:radius="26dp"/></shape></item>
        </layer-list>
    </item>
</selector>
