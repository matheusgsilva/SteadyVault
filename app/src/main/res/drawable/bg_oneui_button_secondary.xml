<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#392A505B"/><stroke android:width="1dp" android:color="#8E9FE7F1"/><corners android:radius="27dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#43FFFFFF" android:centerColor="#33264B55" android:endColor="#180E2229"/><corners android:radius="26dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#25162D35"/><stroke android:width="1dp" android:color="#466D95A0"/><corners android:radius="27dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#31FFFFFF" android:centerColor="#241A3740" android:endColor="#120A1D23"/><stroke android:width="1dp" android:color="#1CFFFFFF"/><corners android:radius="26dp"/></shape></item>
        </layer-list>
    </item>
</selector>
