<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#18162F38"/>
            <stroke android:width="1dp" android:color="#3B7397A0"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="315" android:startColor="#27FFFFFF" android:centerColor="#1C17343D" android:endColor="#0D091A20"/>
            <stroke android:width="1dp" android:color="#16FFFFFF"/>
            <corners android:radius="23dp"/>
        </shape>
    </item>
</layer-list>
