            <item><shape><solid android:color="#322E343D"/><stroke android:width="1dp" android:color="#8AFF6675"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#50FFFFFF" android:centerColor="#282F2730" android:endColor="#120F171C"/><stroke android:width="1dp" android:color="#2CFFFFFF"/><corners android:radius="21dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#211F252E"/><stroke android:width="1dp" android:color="#8AFF6675"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#3AFFFFFF" android:centerColor="#282F2730" android:endColor="#120F171C"/><stroke android:width="1dp" android:color="#1EFFFFFF"/><corners android:radius="21dp"/></shape></item>
        </layer-list>
    </item>
