<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#514C9CAA"/><stroke android:width="1dp" android:color="#C0C6F7FC"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="315" android:startColor="#66FFFFFF" android:centerColor="#4C65CBD8" android:endColor="#26215360"/><stroke android:width="1dp" android:color="#38FFFFFF"/><corners android:radius="21dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#43458C99"/><stroke android:width="1dp" android:color="#A98BE7F4"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="315" android:startColor="#54FFFFFF" android:centerColor="#3F57B8C5" android:endColor="#211A4651"/><stroke android:width="1dp" android:color="#2DFFFFFF"/><corners android:radius="21dp"/></shape>
            </item>
        </layer-list>
    </item>
</selector>
