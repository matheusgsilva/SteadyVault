<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#3A102933"/>
            <stroke android:width="1dp" android:color="#5B91C8D4"/>
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape>
            <gradient android:angle="315"
                android:startColor="#3FFFFFFF"
                android:centerColor="#3218333D"
                android:endColor="#1A081A21"/>
            <stroke android:width="1dp" android:color="#24D8F6FC"/>
            <corners android:topLeftRadius="29dp" android:topRightRadius="29dp"/>
        </shape>
    </item>
</layer-list>
