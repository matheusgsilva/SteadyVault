        <layer-list>
            <item><shape><solid android:color="#3520716B"/><stroke android:width="1dp" android:color="#8A4DE8D7"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#56FFFFFF" android:centerColor="#2A1E5D59" android:endColor="#11102426"/><stroke android:width="1dp" android:color="#2CFFFFFF"/><corners android:radius="21dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#22184948"/><stroke android:width="1dp" android:color="#8A4DE8D7"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#3EFFFFFF" android:centerColor="#2A1E5D59" android:endColor="#11102426"/><stroke android:width="1dp" android:color="#1EFFFFFF"/><corners android:radius="21dp"/></shape></item>
