<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#39254B58"/><stroke android:width="1dp" android:color="#9BA7F0FA"/><corners android:radius="25dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="315" android:startColor="#42FFFFFF" android:centerColor="#34244C58" android:endColor="#1710222A"/><stroke android:width="1dp" android:color="#26FFFFFF"/><corners android:radius="24dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#2418313A"/><stroke android:width="1dp" android:color="#4E82B5C1"/><corners android:radius="25dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape><gradient android:angle="315" android:startColor="#30FFFFFF" android:centerColor="#241B3A44" android:endColor="#120B2027"/><stroke android:width="1dp" android:color="#1BFFFFFF"/><corners android:radius="24dp"/></shape>
            </item>
        </layer-list>
    </item>
</selector>
