<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#211D313B"/><stroke android:width="1dp" android:color="#3E60717C"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#32FFFFFF" android:centerColor="#181A2A33" android:endColor="#0B0B171D"/><stroke android:width="1dp" android:color="#2CFFFFFF"/><corners android:radius="21dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#1517242D"/><stroke android:width="1dp" android:color="#3E60717C"/><corners android:radius="22dp"/></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><gradient android:angle="315" android:startColor="#24FFFFFF" android:centerColor="#181A2A33" android:endColor="#0B0B171D"/><stroke android:width="1dp" android:color="#1EFFFFFF"/><corners android:radius="21dp"/></shape></item>
        </layer-list>
    </item>
</selector>
