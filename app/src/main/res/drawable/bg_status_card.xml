<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#28153440"/>
            <stroke android:width="1dp" android:color="#669EDBE6"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient android:angle="315"
                android:startColor="#46FFFFFF"
                android:centerColor="#2C1B4550"
                android:endColor="#160A1C23"/>
            <stroke android:width="1dp" android:color="#24D9F7FC"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
</layer-list>
